# EchoTwin touchpad, step 2 of 2 (see 71-touchpad-phonelink.rules). The virtual touchpad is
# a touchpad again for libinput, and READ-only for @USER@: InputActions (inside KWin) can
# follow the fingers, but no program can write fake events into it.
ENV{PHONELINK_PAD}=="1", ENV{ID_INPUT_TOUCHPAD}="1", RUN+="/usr/bin/setfacl -m u:@USER@:r $devnode"
