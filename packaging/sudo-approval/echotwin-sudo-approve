#!/bin/bash
# EchoTwin: approve `sudo` with the phone's fingerprint.
#
# Run by PAM (pam_exec with seteuid) as root, from a root-owned file. It is the only part
# that decides, and it trusts nothing from the user's session:
#   1. makes a fresh random nonce (so a signature can never be replayed),
#   2. asks the user's EchoTwin service, run AS THE USER, to get the phone to sign it,
#   3. checks the signature itself with openssl against the root-owned phone key.
# Exit 0 only for a valid signature; anything else exits 1 and sudo asks for the password
# as usual (the PAM line is "sufficient").
#
# Test mode (packaging/sudo-approval/test.sh): honoured only with ECHOTWIN_TEST=1 AND
# PAM_SERVICE=echotwin-test. Under sudo, pam_exec builds the environment from PAM itself
# (PAM_SERVICE=sudo), so a user can't switch it on.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

KEY=/etc/echotwin/approve.pub
test_mode=0
if [ "${ECHOTWIN_TEST:-}" = 1 ] && [ "${PAM_SERVICE:-}" = echotwin-test ]; then
    test_mode=1
    KEY=${ECHOTWIN_KEY:?}
fi

[ "${PAM_TYPE:-}" = auth ] || exit 1
user=${PAM_USER:-}
[[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || exit 1
entry=$(getent passwd "$user") || exit 1
uid=$(cut -d: -f3 <<<"$entry")
home=$(cut -d: -f6 <<<"$entry")
[[ $uid =~ ^[0-9]+$ ]] || exit 1
[ -r "$KEY" ] || exit 1

nonce=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
[[ $nonce =~ ^[0-9a-f]{64}$ ]] || exit 1
code=$(printf '%s' "${nonce:0:4}" | tr a-f A-F)
host=$(hostname 2>/dev/null | tr -cd 'A-Za-z0-9._-' | cut -c1-64)
[ -n "$host" ] || host=computer
echo "EchoTwin: approve on your phone, code $code (or wait for the password prompt)"

if [ "$test_mode" = 1 ]; then
    sig=$(timeout 40 "${ECHOTWIN_RELAY:?}" approve-relay --what sudo --host "$host" --nonce "$nonce" 2>/dev/null) || exit 1
else
    relay="$home/.local/bin/phonelink"
    [ -x "$relay" ] || exit 1
    # Never run the user's program as root: runuser drops to the user, with a clean environment.
    sig=$(timeout 40 runuser -u "$user" -- env -i HOME="$home" XDG_RUNTIME_DIR="/run/user/$uid" \
        "$relay" approve-relay --what sudo --host "$host" --nonce "$nonce" 2>/dev/null) || exit 1
fi

# A DER ECDSA signature in hex: nothing else is accepted.
[[ $sig =~ ^[0-9a-f]{16,320}$ ]] || exit 1
(( ${#sig} % 2 == 0 )) || exit 1

dir=$(mktemp -d) || exit 1
trap 'rm -rf "$dir"' EXIT
# The exact bytes the phone signs (core/src/message.rs approve_message).
printf 'echotwin-approve-v1\n%s\n%s\n%s\n' sudo "$host" "$nonce" >"$dir/msg"
printf '%b' "$(sed 's/../\\x&/g' <<<"$sig")" >"$dir/sig"
out=$(openssl dgst -sha256 -verify "$KEY" -signature "$dir/sig" "$dir/msg" 2>/dev/null) || exit 1
[ "$out" = "Verified OK" ] || exit 1
exit 0
